      "html": "<button class=\"ds-submit\" type=\"button\">Submit</button>",
      "css": ".ds-submit{font-family:'BetterMarmo Geist',Geist,system-ui,sans-serif;font-size:14px;line-height:1.65;background:var(--bm-action,#171717);color:var(--bm-surface,#fff);border:1px solid var(--bm-action,#171717);border-radius:4px;padding:11px 20px;font-weight:550;cursor:pointer}.ds-submit:hover{background:#404040}.ds-submit:focus-visible{outline:3px solid #737373;outline-offset:4px;border-radius:3px}.ds-submit:disabled{opacity:.5;cursor:not-allowed}:host-context([data-bm-theme=\"dark\"]) .ds-submit:hover{background:#d4d4d4}",
