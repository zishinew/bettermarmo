      "name": "Outcome table",
      "kind": "custom",
      "description": "Illustrative neutral outcomes, preserving state through text and weight.",
      "html": "<div class=\"ds-table\"><div class=\"ds-scroll\" tabindex=\"0\" role=\"region\" aria-label=\"Illustrative results\"><table><thead><tr><th>Test</th><th>Outcome</th></tr></thead><tbody><tr><td>Illustrative test</td><td class=\"ds-pass\">Passed</td></tr><tr><td>Illustrative test</td><td class=\"ds-fail\">Failed</td></tr><tr><td>Illustrative test</td><td class=\"ds-pending\">Pending</td></tr></tbody></table></div><p class=\"ds-hint\">Scroll horizontally to see all columns.</p></div>",
      "css": ".ds-table{font-family:'BetterMarmo Geist',Geist,system-ui,sans-serif;font-size:14px;line-height:1.65;border:1px solid var(--bm-line,#e5e5e5);border-radius:6px;overflow:hidden;background:var(--bm-surface,#fff);color:var(--bm-text,#171717)}.ds-scroll{overflow-x:auto}.ds-scroll:focus-visible{outline:3px solid #737373;outline-offset:4px;border-radius:3px}.ds-table table{border-collapse:collapse;width:100%;min-width:760px;font-variant-numeric:tabular-nums}.ds-table th,.ds-table td{padding:13px 16px;border-bottom:1px solid var(--bm-line,#e5e5e5);text-align:left}.ds-table th{font-size:11px;font-weight:500;letter-spacing:.04em;background:var(--bm-soft,#f5f5f5);color:var(--bm-muted,#666)}.ds-table tr:last-child td{border-bottom:0}.ds-table tbody tr:hover td{background:var(--bm-soft,#f5f5f5)}.ds-table .ds-pass,.ds-table tr:hover .ds-pass{background:var(--bm-pass-bg,#fafafa);color:var(--bm-pass,#404040);font-weight:600}.ds-table .ds-fail,.ds-table tr:hover .ds-fail{background:var(--bm-fail-bg,#f0f0f0);color:var(--bm-fail,#171717);font-weight:650}.ds-table .ds-pending{background:var(--bm-pending-bg,#fafafa);color:var(--bm-pending,#666);font-weight:550;font-style:italic}.ds-hint{margin:0;padding:9px 16px;border-top:1px solid var(--bm-line,#e5e5e5);font-size:11px;color:var(--bm-muted,#666)}",
