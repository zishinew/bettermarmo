  "narrative": {
    "northStar": "Monochrome workspace",
    "overview": "The user-approved direction is black and white, very clean and modern, using Composio\u2019s visual language. Locally bundled Geist, square actions, neutral rules and wide tables support dense academic workflows. Dark appearance stays neutral; phone project rows expose labelled fields.",
    "keyCharacteristics": [
      "Monochrome surfaces and actions",
      "Bundled Geist and tabular numbers",
      "Full visible desktop course columns",
      "Labelled phone project fields",
      "Flat surfaces and original workflows"
